# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/creditflow"

# NextAuth — generate a real secret with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# App
NEXT_PUBLIC_APP_NAME="CreditFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
